# FOODOSCOPE_API_KEY: Bearer token for official Foodoscope APIs (RecipeDB & FlavorDB).
# Obtain from https://www.foodoscope.com/ developer dashboard.
FOODOSCOPE_API_KEY="YOUR_FOODOSCOPE_BEARER_TOKEN"

# Foodoscope & CoSyLab IIIT-Delhi Base URLs (Configurable)
RECIPEDB_BASE_URL="https://api.foodoscope.com/recipe2-api"
FLAVORDB_BASE_URL="https://api.foodoscope.com/flavordb"
COSYLAB_FLAVORDB_URL="https://cosylab.iiitd.edu.in/flavordb"
COCKTAILDB_BASE_URL="https://www.thecocktaildb.com/api/json/v1/1"

# GEMINI_API_KEY: Optional for AI-assisted Fusion Lab ideation (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL & PORT
APP_URL="http://localhost:3000"
PORT="3000"

